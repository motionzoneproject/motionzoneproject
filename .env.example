# Database
DATABASE_URL="postgresql://user:password@localhost:5432/motionzone?schema=public"

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP / Email (Ethereal for development)
# Get credentials at https://ethereal.email/ (use real creds in your local .env)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Motion Zone <no-reply@motionzoneworld.com>"

# AWS S3 (optional)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=eu-north-1
S3_PUBLIC_URL=
S3_ENDPOINT=
