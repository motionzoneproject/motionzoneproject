# Database
DATABASE_URL="postgresql://user:password@localhost:5432/motionzone"

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
# Get your API key at https://resend.com/
RESEND_API_KEY=
EMAIL_FROM="Motion Zone <no-reply@motionzoneworld.com>"

# Object storage (Cloudflare R2 or any S3-compatible bucket)
# All six are required for image/video uploads to work — without them
# admin uploads silently fail.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
